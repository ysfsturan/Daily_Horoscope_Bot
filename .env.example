# Zorunlu Bilgiler (GitHub Repository Secrets)
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
CHAT_ID=123456789
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Kişisel Doğum ve Profil Ayarları (GitHub Repository Secrets veya .env)
USER_NAME=Yusuf
BIRTH_DATE=2000-09-26
BIRTH_TIME=04:00
BIRTH_CITY=Istanbul
USER_GOAL=Kariyer, Yazılım ve Kişisel Gelişim

# İsteğe Bağlı Ayarlar (GitHub Repository Variables veya .env)
# Boş bırakılırsa Google AI API üzerinden aktif en güncel Gemini Flash modeli otomatik seçilir.
GEMINI_MODEL=
# Bildirim dili: tr (varsayılan) veya en
LANGUAGE=tr
# Yorum tonu: dengeli (varsayılan), motive, mistik veya kisa
TONE=dengeli
# Yorumdan önce astronomik özet kartını (Natal, Transit, Ay Evresi, Retro) göster
SHOW_CHART_SUMMARY=true
# Alt imza satırını ekle
SHOW_FOOTER=true
# Özel saat dilimi (varsayılan: Europe/Istanbul)
TIMEZONE=Europe/Istanbul
# Şehir listesi yerine manuel enlem/boylam kullanmak isterseniz doldurun
BIRTH_LAT=
BIRTH_LON=
# Uyumluluk analizi için partner burcu (örn: Boğa, Aslan)
PARTNER_SIGN=
